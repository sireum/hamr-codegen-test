package microkit_frame_inexact
public
  with CASE_Scheduling;

  -- D3/D4: a Frame_Period that is not a whole us, converted again by the monitor plugin,
  -- is reported once

  thread a_t
  end a_t;

  thread implementation a_t.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 0 ms .. 100 ms;
  end a_t.i;

  process a_p
  end a_p;

  process implementation a_p.i
    subcomponents
      worker : thread a_t.i;
    properties
      CASE_Scheduling::Domain => 2;
  end a_p.i;

  processor proc
  end proc;

  processor implementation proc.i
    properties
      Frame_Period => 1000500 ns;
      Clock_Period => 2 ms;
      CASE_Scheduling::Max_Domain => 10;
  end proc.i;

  system top
  end top;

  system implementation top.i
    subcomponents
      proc : processor proc.i;
      a : process a_p.i;
    properties
      Actual_Processor_Binding => (reference (proc)) applies to a;
  end top.i;

end microkit_frame_inexact;
