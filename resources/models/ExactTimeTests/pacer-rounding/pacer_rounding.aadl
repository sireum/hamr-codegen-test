package pacer_rounding
public
  with CASE_Scheduling;

  -- D7/D8: a 3 ms Clock_Period: entries round to ticks with warnings, including the pacer's
  -- own slots; a thread without Compute_Execution_Time gets the 50 ms default with a warning

  thread a_t
  end a_t;

  thread implementation a_t.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 0 ms .. 5 ms;
  end a_t.i;

  process a_p
  end a_p;

  process implementation a_p.i
    subcomponents
      worker : thread a_t.i;
    properties
      CASE_Scheduling::Domain => 2;
  end a_p.i;

  thread b_t
  end b_t;

  thread implementation b_t.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
  end b_t.i;

  process b_p
  end b_p;

  process implementation b_p.i
    subcomponents
      worker : thread b_t.i;
    properties
      CASE_Scheduling::Domain => 3;
  end b_p.i;

  processor proc
  end proc;

  processor implementation proc.i
    properties
      Frame_Period => 1000 ms;
      Clock_Period => 3 ms;
      CASE_Scheduling::Max_Domain => 10;
  end proc.i;

  system top
  end top;

  system implementation top.i
    subcomponents
      proc : processor proc.i;
      a : process a_p.i;
      b : process b_p.i;
    properties
      Actual_Processor_Binding => (reference (proc)) applies to a, b;
  end top.i;

end pacer_rounding;
