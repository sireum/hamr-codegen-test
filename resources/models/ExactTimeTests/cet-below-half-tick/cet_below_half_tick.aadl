package cet_below_half_tick
public
  with Base_Types;
  with CASE_Scheduling;

  -- D7: a Compute_Execution_Time below half a Clock_Period rounds to 0 ticks, an error

  thread a_t
    features
      inp : in data port Base_Types::Integer_32;
      outp : out data port Base_Types::Integer_32;
  end a_t;

  thread implementation a_t.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 0 ms .. 1 ms;
  end a_t.i;

  process a_p
    features
      inp : in data port Base_Types::Integer_32;
      outp : out data port Base_Types::Integer_32;
  end a_p;

  process implementation a_p.i
    subcomponents
      worker : thread a_t.i;
    connections
      ci : port inp -> worker.inp;
      co : port worker.outp -> outp;
    properties
      CASE_Scheduling::Domain => 2;
  end a_p.i;

  processor proc
  end proc;

  processor implementation proc.i
    properties
      Frame_Period => 1000 ms;
      Clock_Period => 4 ms;
      CASE_Scheduling::Max_Domain => 10;
  end proc.i;

  system top
  end top;

  system implementation top.i
    subcomponents
      proc : processor proc.i;
      a : process a_p.i;
    properties
      Actual_Processor_Binding => (reference (proc)) applies to a;
  end top.i;

end cet_below_half_tick;
