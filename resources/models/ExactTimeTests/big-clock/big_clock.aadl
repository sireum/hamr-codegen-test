package big_clock
public
  with Base_Types;
  with CASE_Scheduling;

  -- D7: with a 25 ms Clock_Period the pacer's 10 ms slots are clamped to one tick, with warnings

  thread a_t
    features
      inp : in data port Base_Types::Integer_32;
      outp : out data port Base_Types::Integer_32;
  end a_t;

  thread implementation a_t.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 0 ms .. 25 ms;
  end a_t.i;

  process a_p
    features
      inp : in data port Base_Types::Integer_32;
      outp : out data port Base_Types::Integer_32;
  end a_p;

  process implementation a_p.i
    subcomponents
      worker : thread a_t.i;
    connections
      ci : port inp -> worker.inp;
      co : port worker.outp -> outp;
    properties
      CASE_Scheduling::Domain => 2;
  end a_p.i;

  thread b_t
    features
      inp : in data port Base_Types::Integer_32;
      outp : out data port Base_Types::Integer_32;
  end b_t;

  thread implementation b_t.i
    properties
      Dispatch_Protocol => Periodic;
      Period => 1000 ms;
      Compute_Execution_Time => 0 ms .. 25 ms;
  end b_t.i;

  process b_p
    features
      inp : in data port Base_Types::Integer_32;
      outp : out data port Base_Types::Integer_32;
  end b_p;

  process implementation b_p.i
    subcomponents
      worker : thread b_t.i;
    connections
      ci : port inp -> worker.inp;
      co : port worker.outp -> outp;
    properties
      CASE_Scheduling::Domain => 3;
  end b_p.i;

  processor proc
  end proc;

  processor implementation proc.i
    properties
      Frame_Period => 1000 ms;
      Clock_Period => 25 ms;
      CASE_Scheduling::Max_Domain => 10;
  end proc.i;

  system top
  end top;

  system implementation top.i
    subcomponents
      proc : processor proc.i;
      a : process a_p.i;
      b : process b_p.i;
    connections
      c0 : port a.outp -> b.inp;
      c1 : port b.outp -> a.inp;
    properties
      Actual_Processor_Binding => (reference (proc)) applies to a, b;
  end top.i;

end big_clock;
